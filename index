let custom = JSON.parse(localStorage.getItem("usucapion_custom") || "[]");

function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));}
function linkList(urls){return (urls||[]).map(u=>`<a href="${esc(u)}" target="_blank" rel="noopener">${esc(u)}</a>`).join("")}
function row(r,i,remove=false){
 let pos=r.position==="Declarativa"?"decl":"const", scope=r.scope.startsWith("Nacional")?"nat":"int";
 return `<tr><td>${esc(r.id??i+1)}</td><td>${esc(r.title)}</td><td><span class="badge ${scope}">${esc(r.scope)}</span></td><td>${esc(r.format)}</td><td><span class="badge ${pos}">${esc(r.position)}</span></td><td class="url-list">${linkList(r.urls)}</td>${remove?`<td><button class="action btn-danger" onclick="removeCustom(${i})">quitar</button></td>`:""}</tr>`;
}
function renderBase(){
 const q=document.getElementById("searchBase").value.toLowerCase(), f=document.getElementById("filterBase").value;
 const out=base.filter(r=>(!q||JSON.stringify(r).toLowerCase().includes(q))&&(!f||r.position===f));
 document.getElementById("baseBody").innerHTML=out.map((r,i)=>row(r,i)).join("")||`<tr><td colspan="6">sin resultados</td></tr>`;
}
function renderCustom(){
 const q=document.getElementById("searchCustom").value.toLowerCase();
 const out=custom.filter(r=>JSON.stringify(r).toLowerCase().includes(q));
 document.getElementById("customBody").innerHTML=out.map((r,i)=>row(r,i,true)).join("")||`<tr><td colspan="7">sin fuentes agregadas</td></tr>`;
}
function all(){return base.concat(custom)}
function stats(){
 const a=all(), n=a.filter(x=>x.scope.startsWith("Nacional")).length, intl=a.length-n;
 const d=a.filter(x=>x.position==="Declarativa").length, c=a.filter(x=>x.position==="Constitutiva").length;
 document.getElementById("statsCards").innerHTML=[
  [a.length,"fuentes totales"],[n,"nacionales"],[intl,"internacionales"],[d,"declarativas"],[c,"constitutivas"],[a.filter(x=>x.format==="Lectura").length,"lecturas"],[a.filter(x=>x.format==="Audiovisual").length,"audiovisuales"]
 ].map(x=>`<div class="stat"><div class="num">${x[0]}</div><div class="label">${x[1]}</div></div>`).join("");
 draw("scopeChart",["Nacionales","Internacionales"],[n,intl]);
 draw("positionChart",["Declarativas","Constitutivas"],[d,c]);
 const nn=a.filter(x=>x.scope.startsWith("Nacional")&&x.position==="Declarativa").length;
 const nc=a.filter(x=>x.scope.startsWith("Nacional")&&x.position==="Constitutiva").length;
 const ii=a.filter(x=>!x.scope.startsWith("Nacional")&&x.position==="Declarativa").length;
 const ic=a.filter(x=>!x.scope.startsWith("Nacional")&&x.position==="Constitutiva").length;
 draw("crossChart",["Nac/Decl","Nac/Const","Int/Decl","Int/Const"],[nn,nc,ii,ic]);
 const lect=a.filter(x=>x.format==="Lectura").length, aud=a.filter(x=>x.format==="Audiovisual").length;
 draw("formatChart",["Lecturas","Audiovisuales"],[lect,aud]);
}
function draw(id,labels,values){
 const c=document.getElementById(id), ctx=c.getContext("2d"), d=devicePixelRatio||1;
 const w=c.clientWidth,h=c.clientHeight;c.width=w*d;c.height=h*d;ctx.setTransform(d,0,0,d,0,0);
 ctx.clearRect(0,0,w,h); const max=Math.max(...values,1), pad=45, gap=20, bw=(w-pad*2-gap*(values.length-1))/values.length;
 ctx.strokeStyle="#586e75";ctx.fillStyle="#839496";ctx.font="11px monospace";ctx.lineWidth=1;
 ctx.beginPath();ctx.moveTo(pad,15);ctx.lineTo(pad,h-35);ctx.lineTo(w-15,h-35);ctx.stroke();
 values.forEach((v,i)=>{let bh=(h-65)*v/max,x=pad+i*(bw+gap),y=h-35-bh;
  ctx.fillStyle=i%2?"#cb4b16":"#2aa198";ctx.fillRect(x,y,bw,bh);
  ctx.fillStyle="#93a1a1";ctx.textAlign="center";ctx.fillText(labels[i],x+bw/2,h-17);ctx.fillText(v,x+bw/2,y-6);
 });
}
function openModal(){document.getElementById("modal").classList.add("open");document.getElementById("fTitle").focus()}
function closeModal(){document.getElementById("modal").classList.remove("open")}
function addCustom(){
 const title=document.getElementById("fTitle").value.trim(); if(!title)return alert("El título es obligatorio.");
 custom.push({id:"A"+(custom.length+1),title,scope:document.getElementById("fScope").value,format:document.getElementById("fFormat").value,position:document.getElementById("fPosition").value,urls:document.getElementById("fUrls").value.split("\n").map(x=>x.trim()).filter(Boolean)});
 localStorage.setItem("usucapion_custom",JSON.stringify(custom));["fTitle","fUrls"].forEach(id=>document.getElementById(id).value="");closeModal();renderCustom();stats();
}
function removeCustom(i){if(confirm("¿Quitar esta fuente?")){custom.splice(i,1);localStorage.setItem("usucapion_custom",JSON.stringify(custom));renderCustom();stats()}}
function clearCustom(){if(confirm("¿Eliminar todas las fuentes agregadas?")){custom=[];localStorage.removeItem("usucapion_custom");renderCustom();stats()}}
function exportJSON(){download("fuentes-usucapion.json",JSON.stringify(all(),null,2),"application/json")}
function exportCSV(){
 const lines=[["id","title","scope","format","position","urls"].join(",")].concat(all().map(r=>[r.id,r.title,r.scope,r.format,r.position,(r.urls||[]).join(" | ")].map(v=>`"${String(v).replaceAll('"','""')}"`).join(",")));
 download("fuentes-usucapion.csv",lines.join("\n"),"text/csv;charset=utf-8")
}
function download(name,data,type){const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([data],{type}));a.download=name;a.click();URL.revokeObjectURL(a.href)}
document.querySelectorAll("nav button").forEach(b=>b.onclick=()=>{document.querySelectorAll("nav button,.panel").forEach(x=>x.classList.remove("active"));b.classList.add("active");document.getElementById(b.dataset.tab).classList.add("active");if(b.dataset.tab==="stats")stats()});
renderBase();renderCustom();stats();
window.addEventListener("resize",stats);
</script>
